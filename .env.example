# Copy this file to .env and fill in your project values.
# Do not put service_role or secret keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local test account for the Python authentication menu.
# Use a dedicated test account, not your Supabase dashboard account.
# Fill these in .env only. Never commit a real password.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
